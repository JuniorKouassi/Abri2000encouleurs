{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "abri2000encouleurs",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/assets/video/*"]
  }
}
